# workstation-setup: managed sway config
# La configurazione Fedora fornisce integrazione hardware, portal e policy kit.
include /etc/sway/config

set $mod Mod4
set $term kitty
set $menu fuzzel

font pango:monospace 10
gaps inner 8
gaps outer 4
default_border pixel 2
smart_gaps on

client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa #89b4fa
client.focused_inactive #45475a #1e1e2e #a6adc8 #45475a #45475a
client.unfocused        #313244 #181825 #6c7086 #313244 #313244

# Queste scorciatoie sostituiscono intenzionalmente quelle del config Fedora incluso sopra.
bindsym --no-warn $mod+Return exec $term
bindsym --no-warn $mod+d exec $menu
bindsym $mod+g exec $HOME/.local/bin/sway-help
bindsym $mod+Shift+x exec swaylock -f -c 11111b
bindsym --no-warn Print exec grim -g "$(slurp)" - | wl-copy

exec_always mako
exec nm-applet --indicator
