// workstation-setup: managed waybar config
{
  "layer": "top",
  "height": 32,
  "spacing": 8,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "battery", "tray"],
  "sway/workspaces": { "disable-scroll": true, "all-outputs": true },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "{calendar}" },
  "network": { "format-wifi": "Wi-Fi {signalStrength}%", "format-ethernet": "LAN", "format-disconnected": "Offline" },
  "pulseaudio": { "format": "Vol {volume}%", "format-muted": "Muted", "on-click": "pavucontrol" },
  "battery": { "format": "Bat {capacity}%", "format-charging": "Bat +{capacity}%" }
}
