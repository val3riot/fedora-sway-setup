# Copia questo file come config/local.env e modifica solo ciò che vuoi sovrascrivere.

# RUN_SYSTEM_UPGRADE=false
# USE_ENGLISH_XDG_DIRS=true

# Container runtime
# INSTALL_PODMAN=false
# Opt-in esplicito per Codex, Claude Code e Copilot CLI.
# INSTALL_AGENTS=true
# INSTALL_LATEX=true
# INSTALL_DOCKER=true
# INSTALL_DOCKER_DESKTOP=true
# DOCKER_ROOTLESS=true
# DOCKER_ROOTLESS_AUTOSTART=true

# Virtualizzazione KVM/QEMU + libvirt + virt-manager
# INSTALL_VIRTUALIZATION=true
# VIRTUALIZATION_AUTOSTART=true
# INSTALL_VAGRANT=true
# VAGRANT_DEFAULT_PROVIDER="libvirt"
# Crea Debian, Fedora e Windows 11 da ISO locali (disabilitato di default).
# CREATE_OPTIONAL_VMS=true
# VM_ISO_DIR="$HOME/ISO"
# VM_DEBIAN_ISO="$VM_ISO_DIR/debian.iso"
# VM_FEDORA_ISO="$VM_ISO_DIR/fedora.iso"
# VM_WINDOWS11_ISO="$VM_ISO_DIR/windows11.iso"
# VM_STORAGE_DIR="/var/lib/libvirt/images"

# INSTALL_JETBRAINS_TOOLBOX=false

# Terminale predefinito per le applicazioni che usano xdg-terminal-exec
# SET_KITTY_AS_DEFAULT_TERMINAL=true

# Applicazioni desktop (RPM Fedora e Flatpak Flathub)
# INSTALL_DISCORD=true
# INSTALL_OBSIDIAN=true
# INSTALL_THUNDERBIRD=true
# INSTALL_LIBREOFFICE=true
# INSTALL_DASH_TO_DOCK=true
# ENABLE_WINDOW_BUTTONS=true

# Profilo energetico applicato automaticamente al boot.
# POWER_MODE_AUTOSTART=true
# POWER_MODE_DEFAULT="dev"
# POWER_MODE_DEV_MAX=60
# POWER_MODE_QUIET_MAX=45
# POWER_MODE_MIN_PERF=10

# SDKMAN_JAVA_CANDIDATES="21.0.12-tem 17.0.20-tem"

# Gli URL dei vendor sono centralizzati in config/sources.env.
# Puoi anche sovrascriverli qui, ad esempio:
# DOCKER_REPO_URL="https://download.docker.com/linux/fedora/docker-ce.repo"
# TAILSCALE_REPO_URL="https://pkgs.tailscale.com/stable/fedora/tailscale.repo"
