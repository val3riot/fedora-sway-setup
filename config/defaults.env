# Directory personali
TOOLS_DIR="$HOME/Tools"
PROJECTS_DIR="$HOME/Progetti"

# Comportamento generale
RUN_SYSTEM_UPGRADE=true
USE_ENGLISH_XDG_DIRS=true

# Componenti principali
INSTALL_PODMAN=false
INSTALL_DOCKER=true
INSTALL_DOCKER_DESKTOP=true
DOCKER_ROOTLESS=true
DOCKER_ROOTLESS_AUTOSTART=true
INSTALL_VIRTUALIZATION=true
VIRTUALIZATION_AUTOSTART=true
INSTALL_VAGRANT=true
VAGRANT_DEFAULT_PROVIDER="libvirt"
# Opt-in: crea tre guest da ISO locali dopo avere configurato libvirt.
CREATE_OPTIONAL_VMS=false
VM_ISO_DIR="$HOME/ISO"
VM_DEBIAN_ISO="$VM_ISO_DIR/debian.iso"
VM_FEDORA_ISO="$VM_ISO_DIR/fedora.iso"
VM_WINDOWS11_ISO="$VM_ISO_DIR/windows11.iso"
VM_STORAGE_DIR="/var/lib/libvirt/images"
INSTALL_VSCODE=true
INSTALL_JETBRAINS_TOOLBOX=true
INSTALL_DBEAVER=true
INSTALL_BRUNO=true
INSTALL_DISCORD=true
INSTALL_OBSIDIAN=true
INSTALL_THUNDERBIRD=true
INSTALL_LIBREOFFICE=true
INSTALL_DASH_TO_DOCK=true
ENABLE_WINDOW_BUTTONS=true
INSTALL_NVM=true
INSTALL_MINICONDA=true
INSTALL_SDKMAN=true
INSTALL_OH_MY_ZSH=true
# Opt-in: gli agenti gestiscono credenziali e possono eseguire codice remoto.
INSTALL_AGENTS=false
INSTALL_LATEX=true
INSTALL_VPN_SUPPORT=true
INSTALL_POWER_MODE=true

# Integrazione terminale desktop
SET_KITTY_AS_DEFAULT_TERMINAL=false

# Profilo energetico predefinito
POWER_MODE_AUTOSTART=true
POWER_MODE_DEFAULT="dev"       # dev, quiet, normal oppure full
POWER_MODE_DEV_MAX=60
POWER_MODE_QUIET_MAX=45
POWER_MODE_MIN_PERF=10

# SDK iniziali. Lascia vuoto per non installare automaticamente.
# SDKMAN: Java LTS usata dal profilo development. Aggiornare esplicitamente quando necessario.
SDKMAN_JAVA_CANDIDATES="21.0.12-tem"
SDKMAN_INSTALL_MAVEN=true
SDKMAN_INSTALL_GRADLE=true

# NVM
NVM_NODE_VERSION="--lts"

# Miniconda
CONDA_AUTO_ACTIVATE_BASE=false
