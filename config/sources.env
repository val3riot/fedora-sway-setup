# Endpoint esterni usati dal setup desktop. Versioni e digest sono in versions.env.

# Shell
OH_MY_ZSH_INSTALL_URL="https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/${OH_MY_ZSH_COMMIT}/tools/install.sh"
STARSHIP_ARCHIVE_URL="https://github.com/starship/starship/releases/download/v${STARSHIP_VERSION}/starship-x86_64-unknown-linux-gnu.tar.gz"

# Quickshell: verified 2026-09-06; Fedora 44 official RPM, no COPR required.
QUICKSHELL_DOCS_URL="https://quickshell.org/docs/v0.2.1/guide/install-setup/"
QUICKSHELL_FEDORA_URL="https://packages.fedoraproject.org/pkgs/quickshell/quickshell/fedora-44.html"
QUICKSHELL_BLUETOOTH_API_URL="https://quickshell.org/docs/v0.2.1/types/Quickshell.Bluetooth/BluetoothDevice/"
QUICKSHELL_PIPEWIRE_API_URL="https://quickshell.org/docs/v0.2.1/types/Quickshell.Services.Pipewire/Pipewire/"
NETWORKMANAGER_LIBNM_API_URL="https://networkmanager.dev/docs/libnm/latest/NMClient.html"
QUICKSHELL_NOTIFICATIONS_API_URL="https://quickshell.org/docs/v0.2.1/types/Quickshell.Services.Notifications/NotificationServer/"
NOTIFICATIONS_SPEC_URL="https://specifications.freedesktop.org/notification/latest/protocol.html"

# BlueTUI official upstream release
BLUETUI_UPSTREAM_URL="https://github.com/pythops/bluetui"
BLUETUI_X86_64_URL="https://github.com/pythops/bluetui/releases/download/v${BLUETUI_VERSION}/bluetui-x86_64-linux-musl"
BLUETUI_AARCH64_URL="https://github.com/pythops/bluetui/releases/download/v${BLUETUI_VERSION}/bluetui-aarch64-linux-musl"
