#!/usr/bin/env python3
# workstation-setup: managed screenshot helper
"""Capture an area, focused output or window; save PNG and copy it to Wayland."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import subprocess


def nodes(node):
    yield node
    for child in node.get('nodes', []) + node.get('floating_nodes', []):
        yield from nodes(child)


def geometry(rect):
    if rect.get('width', 0) <= 0 or rect.get('height', 0) <= 0:
        raise ValueError('Geometria finestra non disponibile.')
    return f"{int(rect['x'])},{int(rect['y'])} {int(rect['width'])}x{int(rect['height'])}"


def capture(mode):
    command = ['grim']
    if mode == 'area':
        selection = subprocess.run(['slurp'], capture_output=True, text=True)
        if selection.returncode != 0 or not selection.stdout.strip(): return None
        command += ['-g', selection.stdout.strip()]
    elif mode == 'output':
        outputs = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_outputs']))
        output = next((o for o in outputs if o.get('focused') and o.get('active')), None)
        if not output: raise ValueError('Output focused non disponibile.')
        command += ['-o', output['name']]
    else:
        tree = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_tree']))
        window = next((n for n in nodes(tree) if n.get('focused') and n.get('pid')), None)
        if not window: raise ValueError('Nessuna finestra focused.')
        command += ['-g', geometry(window['rect'])]
    png = subprocess.check_output([*command, '-'], stderr=subprocess.DEVNULL, timeout=15)
    if not png.startswith(b'\x89PNG\r\n\x1a\n'): raise ValueError('Acquisizione PNG non riuscita.')
    directory = Path.home() / 'Pictures/Screenshots'
    directory.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime('Screenshot_%Y-%m-%d_%H-%M-%S')
    suffix = 0
    while True:
        path = directory / (stamp + (f'_{suffix}' if suffix else '') + '.png')
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError: suffix += 1
    with os.fdopen(descriptor, 'wb') as file: file.write(png)
    try:
        subprocess.run(['wl-copy', '--type', 'image/png'], input=png, check=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        raise ValueError('Screenshot salvato; copia nella clipboard non riuscita.') from None
    subprocess.run(['notify-send', '-u', 'low', '-t', '1400', 'Screenshot salvato', path.name],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return path


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['area', 'output', 'window'])
    try:
        capture(parser.parse_args().mode)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        parser.exit(1, str(error) + '\n')
