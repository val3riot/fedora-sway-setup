#!/usr/bin/env bash
set -Eeuo pipefail

command -v fuzzel >/dev/null 2>&1 || {
  printf '%s\n' 'fuzzel non disponibile' >&2
  exit 1
}

shortcuts=(
  'Super + Invio             Apri il terminale'
  'Super + D                 Cerca applicazioni'
  'Super + Maiusc + Q        Chiudi la finestra attiva'
  'Super + Maiusc + C        Ricarica Sway'
  'Super + Maiusc + E        Esci da Sway'
  'Super + Maiusc + X        Blocca lo schermo'
  'Super + B                 Dividi in orizzontale'
  'Super + V                 Dividi in verticale'
  'Super + F                 Attiva/disattiva tutto schermo'
  'Super + 1…0               Passa al workspace 1…10'
  'Super + H/J/K/L           Sposta il focus'
  'Super + frecce            Sposta il focus'
  'Super + Maiusc + H/J/K/L  Sposta la finestra'
  'Tasti volume              Regola o disattiva il volume'
  'Tasti luminosità          Regola la luminosità'
  'Tasti multimediali        Controlla la riproduzione'
)

screen_width=1280
screen_height=720
if command -v swaymsg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  focused_output="$(swaymsg -t get_workspaces -r 2>/dev/null |
    jq -r 'first(.[] | select(.focused) | .output) // empty')"
  if [[ -n "$focused_output" ]]; then
    read -r detected_width detected_height < <(
      swaymsg -t get_outputs -r 2>/dev/null |
        jq -r --arg output "$focused_output" \
          'first(.[] | select(.active and .name == $output) | "\(.rect.width) \(.rect.height)") // empty'
    ) || true
    screen_width="${detected_width:-$screen_width}"
    screen_height="${detected_height:-$screen_height}"
  fi
fi

# Fuzzel esprime la larghezza in caratteri, ma altezza e margini in pixel
# logici. Manteniamo sempre il pannello sotto Waybar (30 px) e dentro l'output.
top_margin=38
bottom_margin=12
font_size=10
line_height=30
vertical_pad=10
inner_pad=8
if (( screen_height < 700 )); then
  font_size=9
  line_height=26
  vertical_pad=8
fi

fixed_height=$((line_height + vertical_pad * 2 + inner_pad + 4))
max_lines=$(((screen_height - top_margin - bottom_margin - fixed_height) / line_height))
(( max_lines < 4 )) && max_lines=4
(( max_lines > ${#shortcuts[@]} )) && max_lines=${#shortcuts[@]}

menu_width=$(((screen_width - 92) / 7))
(( menu_width < 32 )) && menu_width=32
(( menu_width > 58 )) && menu_width=58

printf '%s\n' "${shortcuts[@]}" |
  fuzzel --dmenu --prompt='Scorciatoie > ' \
    --anchor=top --y-margin="$top_margin" \
    --dpi-aware=no \
    --font="CaskaydiaMono Nerd Font:size=$font_size" \
    --width="$menu_width" --lines="$max_lines" --minimal-lines \
    --line-height="$line_height" --horizontal-pad=14 \
    --vertical-pad="$vertical_pad" --inner-pad="$inner_pad" \
    >/dev/null || true
