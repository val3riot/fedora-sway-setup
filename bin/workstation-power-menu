#!/usr/bin/env bash
set -Eeuo pipefail

menu() {
  fuzzel --dmenu --prompt="$1" --width=28 --lines="$2" --minimal-lines \
    --no-exit-on-keyboard-focus-loss
}

confirm() {
  local action=$1
  [[ "$(printf '%s\n' 'No, annulla' "Sì, $action" | menu 'Conferma › ' 2)" == "Sì, $action" ]]
}

choice="$(printf '%s\n' '󰌾  Blocca schermo' '󰜉  Riavvia' '󰐥  Spegni' | menu 'Sistema › ' 3)" || exit 0

case "$choice" in
  '󰌾  Blocca schermo') exec "$HOME/.local/bin/workstation-lock" ;;
  '󰜉  Riavvia') confirm riavviare && exec systemctl reboot ;;
  '󰐥  Spegni') confirm spegnere && exec systemctl poweroff ;;
esac
