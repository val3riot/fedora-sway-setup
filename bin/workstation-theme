#!/usr/bin/env bash
set -Eeuo pipefail

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
theme_root="$data_home/workstation-setup/themes"
state_dir="$state_home/workstation-setup"
state_file="$state_dir/theme"

current_theme() {
  [[ -r "$state_file" ]] && read -r current < "$state_file" || current=dark
  printf '%s\n' "$current"
}

requested="${1:-toggle}"
case "$requested" in
  current) current_theme; exit 0 ;;
  toggle)
    [[ "$(current_theme)" == dark ]] && requested=light || requested=dark
    ;;
  dark|light) ;;
  *) printf 'Uso: %s [dark|light|toggle|current]\n' "${0##*/}" >&2; exit 2 ;;
esac

source_dir="$theme_root/$requested"
[[ -d "$source_dir" ]] || {
  printf 'Tema non installato: %s\n' "$requested" >&2
  exit 1
}

install -D -m 0644 "$source_dir/waybar.css" "$HOME/.config/waybar/theme.css"
install -D -m 0644 "$source_dir/fuzzel.ini" "$HOME/.config/fuzzel/fuzzel.ini"
install -D -m 0644 "$source_dir/kitty.conf" "$HOME/.config/kitty/theme.conf"
install -D -m 0644 "$source_dir/mako.conf" "$HOME/.config/mako/config"
mkdir -p "$state_dir"
printf '%s\n' "$requested" > "$state_file"

if command -v gsettings >/dev/null 2>&1; then
  if [[ "$requested" == dark ]]; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita
  else
    gsettings set org.gnome.desktop.interface color-scheme prefer-light
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita
  fi
fi

pkill -SIGUSR2 -x waybar 2>/dev/null || true
pkill -SIGUSR1 -x kitty 2>/dev/null || true
command -v makoctl >/dev/null 2>&1 && makoctl reload >/dev/null 2>&1 || true
if pgrep -f '^/usr/libexec/lxqt-policykit-agent$' >/dev/null 2>&1; then
  pkill -f '^/usr/libexec/lxqt-policykit-agent$' || true
  command -v swaymsg >/dev/null 2>&1 &&
    swaymsg exec "$HOME/.local/bin/workstation-policykit-agent" >/dev/null 2>&1 || true
fi
command -v notify-send >/dev/null 2>&1 &&
  notify-send 'Tema aggiornato' "$([[ "$requested" == dark ]] && printf 'Scuro · arancione' || printf 'Avorio caldo')" || true
