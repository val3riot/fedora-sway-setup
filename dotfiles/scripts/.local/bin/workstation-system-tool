#!/usr/bin/env python3
# workstation-setup: managed system utility launcher
"""Dedicated, bounded Kitty windows; ordinary terminals retain their configuration."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess

KINDS = ('bluetooth', 'audio', 'network', 'storage', 'system-monitor', 'system-tool')


def dimensions(rect):
    return min(860, max(240, rect['width'] - 48)), min(580, max(160, rect['height'] - 96))


def kitty_command(kind, command, rect):
    width, height = dimensions(rect)
    return ['/usr/bin/kitty', '--app-id', 'workstation-' + kind, '--title', 'System · ' + kind,
            '-o', 'remember_window_size=no', '-o', 'initial_window_width=' + str(width),
            '-o', 'initial_window_height=' + str(height), *command]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('kind', choices=KINDS)
    parser.add_argument('command', nargs=argparse.REMAINDER, help='future utility: -- executable [args]')
    args = parser.parse_args()
    command = args.command
    if command[:1] == ['--']:
        command = command[1:]
    if not command and args.kind == 'bluetooth':
        command = [str(Path.home() / '.local/bin/bluetui')]
    if not command and args.kind == 'network':
        command = [shutil.which('nmtui') or '/usr/bin/nmtui']
    if not command or not shutil.which(command[0]):
        parser.error('TUI assente: installare la release prevista dal setup.')
    if not os.environ.get('SWAYSOCK'):
        parser.error('È richiesta una sessione Sway.')
    # Fixed whitelist: neither titles nor application/device text become IPC commands.
    tree = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_tree'], timeout=3))
    def find(node):
        if node.get('app_id') == 'workstation-' + args.kind:
            return node['id']
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            found = find(child)
            if found is not None:
                return found
        return None
    existing = find(tree)
    if existing is not None:
        subprocess.run(['swaymsg', '[con_id=' + str(existing) + '] focus'], check=True, timeout=3)
        return
    outputs = json.loads(subprocess.check_output(['swaymsg', '-r', '-t', 'get_outputs'], timeout=3))
    active = [o for o in outputs if o.get('active')]
    output = next((o for o in active if o.get('focused')), active[0] if active else None)
    if output is None:
        parser.error('Nessun output Sway attivo.')
    command = kitty_command(args.kind, command, output['rect'])
    os.execv(command[0], command)


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        raise SystemExit('Utility di sistema non avviabile: ' + str(error)) from error
