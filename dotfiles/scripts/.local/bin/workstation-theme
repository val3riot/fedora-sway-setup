#!/usr/bin/env bash
# workstation-setup: managed theme enforcer (Adwaita Dark / #e88923 accent)
set -Eeuo pipefail

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
state_dir="$state_home/workstation-setup"
state_file="$state_dir/theme"

current_theme() {
  printf '%s\n' "dark"
}

action="${1:-dark}"
case "$action" in
  current) current_theme; exit 0 ;;
  dark|apply) ;;
  *) printf 'Uso: %s [dark|current|apply]\n' "${0##*/}" >&2; exit 2 ;;
esac

mkdir -p "$state_dir"
printf 'dark\n' > "$state_file"

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." 2>/dev/null && pwd || true)"
kitty_src=""
for candidate in "$repo_root/templates/themes/dark/kitty.conf" "$HOME/.local/share/workstation-setup/themes/dark/kitty.conf"; do
  if [[ -f "$candidate" ]]; then
    kitty_src="$candidate"
    break
  fi
done

if [[ -n "$kitty_src" ]]; then
  install -D -m 0644 "$kitty_src" "$HOME/.config/kitty/theme.conf"
fi

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita 2>/dev/null || true
fi

pkill -SIGUSR1 -x kitty 2>/dev/null || true
