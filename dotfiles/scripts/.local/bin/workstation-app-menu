#!/usr/bin/env bash
set -Eeuo pipefail

command -v fuzzel >/dev/null 2>&1 || {
  printf '%s\n' 'fuzzel non disponibile' >&2
  exit 1
}

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
pid_file="$runtime_dir/workstation-app-menu.pid"

if [[ -r "$pid_file" ]]; then
  read -r menu_pid < "$pid_file" || menu_pid=
  if [[ "$menu_pid" =~ ^[0-9]+$ ]] &&
    [[ -r "/proc/$menu_pid/cmdline" ]] &&
    tr '\0' ' ' < "/proc/$menu_pid/cmdline" | grep -Fq -- '--namespace=workstation-app-menu'; then
    kill -TERM "$menu_pid"
    rm -f "$pid_file"
    exit 0
  fi
  rm -f "$pid_file"
fi

printf '%s\n' "$$" > "$pid_file"
exec fuzzel --namespace=workstation-app-menu
