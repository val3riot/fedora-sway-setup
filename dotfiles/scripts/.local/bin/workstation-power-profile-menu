#!/usr/bin/env bash
set -Eeuo pipefail

for command_name in fuzzel pkexec laptop-power-mode; do
  command -v "$command_name" >/dev/null 2>&1 || {
    notify-send 'Profilo energetico' "$command_name non disponibile" 2>/dev/null || true
    exit 1
  }
done

choice="$(printf '%s\n' 'Dev 60%' 'Risparmio' 'Prestazioni' |
  fuzzel --dmenu --prompt='Profilo energetico > ' --width=30 --lines=3 --minimal-lines \
    --no-exit-on-keyboard-focus-loss)" || exit 0

case "$choice" in
  'Dev 60%')
    label='Dev 60%'
    mode=(dev 60)
    ;;
  'Risparmio')
    label='Risparmio'
    mode=(quiet)
    ;;
  'Prestazioni')
    label='Prestazioni'
    mode=(full)
    ;;
  *) exit 0 ;;
esac

if pkexec /usr/local/bin/laptop-power-mode "${mode[@]}" >/dev/null; then
  notify-send 'Profilo energetico' "Attivato: $label" 2>/dev/null || true
else
  notify-send --urgency=critical 'Profilo energetico' "Cambio non riuscito: $label" 2>/dev/null || true
  exit 1
fi
