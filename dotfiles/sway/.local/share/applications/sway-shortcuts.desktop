# workstation-setup: managed Sway shortcuts entry
[Desktop Entry]
Type=Application
Name=Tasti rapidi e scorciatoie da tastiera
GenericName=Tasti e shortcut di Sway
Comment=Mostra e cerca le combinazioni di tasti disponibili
Keywords=scorciatoie;shortcut;tasti;comandi;tastiera;sway;
Icon=preferences-desktop-keyboard-shortcuts
Exec=/usr/bin/zsh -lc "exec \\$HOME/.local/bin/sway-shortcuts"
Terminal=false
Categories=Utility;
